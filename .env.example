# Copy to .env. The web launcher reads it; existing shell variables take precedence.
DECISION_ROOM_AGENT_MODEL=qwen3.8-27b-splash
DECISION_ROOM_AGENT_PROTOCOL=lmstudio_structured
DECISION_ROOM_AGENT_BASE_URL=http://127.0.0.1:1234/v1
DECISION_ROOM_AGENT_REASONING=off
# Local evaluation setting; adapt after measuring another model/provider.
DECISION_ROOM_AGENT_TIMEOUT=300
# Optional for an authenticated model server. Never commit a real credential.
DECISION_ROOM_AGENT_API_KEY=
# OpenAI uses its own key so it is never sent to the local model server.
OPENAI_API_KEY=
# To use OpenAI, set MODEL=gpt-6-luna, PROTOCOL=openai,
# BASE_URL=https://api.openai.com/v1 and REASONING=low above.
# Optional OpenAI embeddings + PostgreSQL pgvector (also works with a local agent).
# Enable after configuring OPENAI_API_KEY; embedding calls are billed separately.
DECISION_ROOM_SEMANTIC_SEARCH=false
DECISION_ROOM_EMBEDDING_MODEL=text-embedding-3-small
DECISION_ROOM_EMBEDDING_DIMENSIONS=1536
# New analyses use the native report engine (opencode + blocks) when the pinned
# engine image is configured; without it they fall back to legacy.
# Set DECISION_ROOM_REPORT_ENGINE=legacy or DECISION_ROOM_REPORT_FORMAT=html to opt out.
DECISION_ROOM_ENGINE_IMAGE_ID=
DECISION_ROOM_REPORT_ENGINE=opencode
DECISION_ROOM_REPORT_FORMAT=blocks
# Catalogue ceiling for newly created engine reports.
# Does not upgrade existing jobs or include chat/embedding calls.
DECISION_ROOM_ENGINE_USD_CAP=1.00
