# Export these variables in the terminal; the application does not auto-load .env.
DECISION_ROOM_AGENT_MODEL=qwen3.8-27b-splash
DECISION_ROOM_AGENT_PROTOCOL=lmstudio_structured
DECISION_ROOM_AGENT_BASE_URL=http://127.0.0.1:1234/v1
DECISION_ROOM_AGENT_REASONING=off
# Local evaluation setting; adapt after measuring another model/provider.
DECISION_ROOM_AGENT_TIMEOUT=300
# Optional for an authenticated model server. Never commit a real credential.
# DECISION_ROOM_AGENT_API_KEY=
